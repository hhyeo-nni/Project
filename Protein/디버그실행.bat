@echo off
chcp 65001 >nul
REM ============================================================
REM  프로틴 할인 알림 - 디버그 실행 (콘솔 창에 로그를 실시간 출력)
REM  문제가 생겼을 때 이 파일로 실행해서 로그를 직접 눈으로 확인하세요.
REM  창을 닫으면 프로그램도 함께 종료됩니다.
REM ============================================================

REM 스크립트가 있는 폴더로 작업 디렉터리를 고정한다
cd /d "%~dp0"

REM Windows 콘솔 기본 인코딩(cp949)에서 한글 로그가 깨지는 것을 막기 위해
REM 파이썬 표준입출력 인코딩을 utf-8로 강제한다.
set PYTHONIOENCODING=utf-8

echo ============================================================
echo  프로틴 할인 알림 - 디버그 모드
echo  (종료하려면 이 창을 닫거나 트레이 메뉴에서 "종료"를 누르세요)
echo ============================================================
echo.

python "%~dp0main.py"

echo.
echo ============================================================
echo  프로그램이 종료되었습니다. (종료 코드: %errorlevel%)
echo ============================================================
pause
